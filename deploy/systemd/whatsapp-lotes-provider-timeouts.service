[Unit]
Description=Detectar timeouts de proveedores WhatsApp Lotes
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=whatsapp-lotes
Group=whatsapp-lotes
WorkingDirectory=/opt/whatsapp-lotes-bot
EnvironmentFile=/opt/whatsapp-lotes-bot/.env
Environment=PYTHONPATH=/opt/whatsapp-lotes-bot
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/whatsapp-lotes-bot/venv/bin/python \
    /opt/whatsapp-lotes-bot/scripts/process_provider_timeouts.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
