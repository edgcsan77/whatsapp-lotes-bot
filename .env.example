APP_NAME=whatsapp-lotes-bot
APP_ENV=production
TZ=America/Monterrey

APP_HOST=127.0.0.1
APP_PORT=8200
APP_SECRET_KEY=CAMBIA_APP_SECRET_KEY

DATABASE_URL=postgresql+psycopg://whatsapp_lotes_app:CAMBIA_PASSWORD_DB@127.0.0.1:5432/whatsapp_lotes_db
REDIS_URL=redis://:CAMBIA_PASSWORD_REDIS@127.0.0.1:6379/0

EVOLUTION_BASE_URL=http://2.25.207.41:8080
EVOLUTION_API_KEY=CAMBIA_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=CAMBIA_INSTANCIA_NUEVA
EVOLUTION_WEBHOOK_SECRET=CAMBIA_WEBHOOK_SECRET

PUBLIC_BASE_URL=https://CAMBIA_DOMINIO
ADMIN_SESSION_SECRET=CAMBIA_ADMIN_SESSION_SECRET

DEFAULT_BATCH_INTERVAL_MINUTES=15
DEFAULT_BATCH_MAX_ITEMS=50
DEFAULT_DAILY_CUTOFF_TIME=23:30
DEFAULT_TIMEZONE=America/Monterrey

CHROME_BIN=/usr/bin/google-chrome-stable
CHROMEDRIVER_BIN=/usr/local/bin/chromedriver-google

# JIDs autorizados para comandos administrativos de WhatsApp.
# Separar múltiples administradores con coma.
WHATSAPP_ADMIN_JIDS=
